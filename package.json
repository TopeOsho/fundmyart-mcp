{
  "name": "fundmyart-mcp",
  "version": "0.1.0",
  "description": "MCP server for FundMyArt — search 1,999 verified arts and culture grants from Claude, ChatGPT, Cursor, or any MCP-compatible LLM client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fundmyart-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "art",
    "arts",
    "grants",
    "funding",
    "artists",
    "culture",
    "residency",
    "fundmyart"
  ],
  "author": "fundergallery",
  "license": "MIT",
  "homepage": "https://fund-my-art.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TopeOsho/fundmyart-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/TopeOsho/fundmyart-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.103.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
